; ~/.gitconfig.local should define user.name, user.email, and user.signingKey
; for example: git config -f ~/.gitconfig.local user.name "Your Name"
[include]
	path = ~/.gitconfig.local
[gpg]
	format = ssh
[commit]
	gpgSign = true
[pager]
	branch = false
[core]
	pager = diff-so-fancy | less --tabs=4 -R
[color]
	ui = auto
[color "diff-highlight"]
	oldNormal = red bold
	oldHighlight = red bold 52
	newNormal = green bold
	newHighlight = green bold 22
[color "diff"]
	meta = cyan
	frag = magenta bold
	commit = yellow bold
	old = red bold
	new = green bold
	whitespace = red reverse
[diff-so-fancy]
	markEmptyLines = false
[init]
	defaultBranch = main
[fetch]
	prune = true
[merge]
	conflictStyle = zdiff3
[pull]
	ff = only
[push]
	autoSetupRemote = true
